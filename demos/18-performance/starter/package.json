    "axios": "1.20.0",
    "bootstrap": "5.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "react": "19.3.0",
    "react-bootstrap": "2.10.10",
    "react-bootstrap-icons": "1.11.6",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.5",
    "react-hook-form": "7.88.0",
    "react-router": "8.3.1",
    "web-vitals": "6.2.2",
