# Loaded by `npm run dev`. Committed on purpose — nothing here is secret.
# Every VITE_ variable is compiled into the public bundle; see the guide.
VITE_APP_NAME=ShopScope (dev)
VITE_API_BASE_URL=https://dummyjson.com
VITE_API_TIMEOUT_MS=30000
VITE_LOG_LEVEL=debug
VITE_FEATURE_UPLOADS=true
VITE_PAGE_SIZE=12
