# Loaded by Vitest, whose default mode is `test`. Without it `src/config/env.ts`
# throws on import and every test file fails to collect before it runs a line.
VITE_APP_NAME=ShopScope (test)
VITE_API_BASE_URL=https://dummyjson.com
VITE_API_TIMEOUT_MS=10000
VITE_LOG_LEVEL=error
VITE_FEATURE_UPLOADS=false
VITE_PAGE_SIZE=12
VITE_UPLOAD_BASE_URL=https://httpbin.org
